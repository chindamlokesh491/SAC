{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "API_SERVER_ORIGIN", "MEDIA_PUBLIC_ORIGIN", "ADMIN_APP_URL", "NODE_ENV"]
    },
    "typecheck": { "outputs": [] },
    "lint": { "outputs": [] },
    "test": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}

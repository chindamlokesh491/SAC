# Public build-time values (compiled into the app — never put secrets here).
# Android emulator reaches the host machine at 10.0.2.2; a phone needs your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000
# Google sign-in (OAuth client IDs are public identifiers). Leave empty to hide the button.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Enable only after the native Razorpay SDK is integrated and sandbox-tested.
EXPO_PUBLIC_ONLINE_PAYMENTS_IN_APP=false
# Domain the Android app opens links for (must serve /.well-known/assetlinks.json).
APP_LINK_HOST=sriananthacart.in

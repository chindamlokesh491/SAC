# Server-side only: where Next.js proxies /api and /media, and fetches the catalogue from.
API_SERVER_ORIGIN=http://127.0.0.1:4000
# Server-side only: must equal the API's INTERNAL_API_TOKEN. Never prefix with NEXT_PUBLIC_.
INTERNAL_API_TOKEN=

# Public build-time values (compiled into the browser bundle - never put secrets here).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth web client ID (a public identifier). Leave empty to hide "Continue with Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Link to the Android app (Play Store URL once published). Leave empty to hide the badge.
NEXT_PUBLIC_ANDROID_APK_URL=

# Play App Signing SHA-256 fingerprint(s), comma-separated, for Android App Links.
ANDROID_CERT_SHA256=

# Server-side only: shared with the worker (REVALIDATE_TOKEN there too, 32+ random characters) so admin
# changes refresh the cached catalogue at once. Never prefix with NEXT_PUBLIC_.
REVALIDATE_TOKEN=
# Set when product images are served from Supabase Storage: https://<project-ref>.supabase.co (public).
# MEDIA_PUBLIC_ORIGIN=
# Optional: send /admin/* on the shop domain to the separate admin app, e.g. https://admin.<your-domain>
# ADMIN_APP_URL=

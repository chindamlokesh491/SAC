# Admin web app (Next.js). Copy to .env.local for local development. Nothing here is secret.
# The API's address as seen from this server; /api and /media are proxied there (same-origin cookies).
API_SERVER_ORIGIN=http://127.0.0.1:4000
# Where "View storefront" points.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# Set when product images are served from Supabase Storage: https://<project-ref>.supabase.co
# MEDIA_PUBLIC_ORIGIN=

# Optional: staff "Sign in with Google". Public OAuth web client ID (not a secret). When unset,
# the admin app loads no Google script and its CSP blocks accounts.google.com.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

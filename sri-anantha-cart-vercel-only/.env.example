# API configuration. Copy to apps/api/.env (git-ignored) for local development.
# Never commit real secrets; in production set them in the hosting dashboard.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# API and worker database login. In production: the Supabase pooler as the least-privilege role
# (sac_app_runtime.<project-ref>, see database/roles/app_runtime_role.sql), never the owner.
DATABASE_URL=postgresql://sac_dev:replace_me@localhost:5432/sri_anantha_cart
# Owner login, used ONLY to run migrations (pnpm --filter @sac/api migrate).
# MIGRATION_DATABASE_URL=
DATABASE_SSL=false
# Supabase CA certificate (PEM; "\n" escapes allowed) so the database certificate is verified.
# DATABASE_SSL_CA=
DATABASE_POOL_SIZE=3
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=replace-with-a-long-random-secret

# Public HTTPS origin of the storefront (used for verified checkout return links).
PUBLIC_WEB_URL=http://localhost:3000
# Number of trusted proxies in front of the API (1 for the Vercel ingress).
TRUST_PROXY=false
# Defaults to true in production. Session cookies are HttpOnly and SameSite=Lax regardless.
COOKIE_SECURE=false
# Uploaded product images (re-encoded WebP, three sizes): local disk for development,
# Supabase Storage in production (MEDIA_STORAGE=supabase).
MEDIA_STORAGE=local
MEDIA_DIR=var/media
# https://<project-ref>.supabase.co (public).
# SUPABASE_URL=
# SECRET, server-side only (API and worker). Never in a NEXT_PUBLIC_/EXPO_PUBLIC_ variable or a client.
# SUPABASE_SERVICE_ROLE_KEY=
# Shared with the web server only, so its cached catalogue reads are not IP rate-limited.
INTERNAL_API_TOKEN=
# Vercel Cron bearer secret. Vercel sends Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=

# Deployment identity is independent of NODE_ENV (Render staging commonly runs NODE_ENV=production).
DEPLOYMENT_ENV=development
ALLOW_DEV_OTP=false

# SMS OTP. Production should use OTP_PROVIDER=smsgatewayhub with approved DLT settings (or http for another gateway).
# Local development uses dev-outbox. Remote staging requires DEPLOYMENT_ENV=staging and ALLOW_DEV_OTP=true.
OTP_PROVIDER=dev-outbox
OTP_DEV_OUTBOX=var/otp-outbox.jsonl
OTP_SEND_URL=
OTP_API_KEY=
# SMS Gateway Hub DLT OTP (use only after approved DLT template details are available).
# Set OTP_PROVIDER=smsgatewayhub only after every required value below is configured.
SMSGH_API_KEY=
SMSGH_SENDER_ID=
SMSGH_ENTITY_ID=
SMSGH_OTP_TEMPLATE_ID=
# Exact approved DLT text with one {#var#}, {#numeric#}, or {#alphanumeric#} placeholder.
SMSGH_OTP_TEMPLATE_TEXT=
# 2 = transactional/service; use OTP only if the SMS Gateway Hub account is provisioned for that channel.
SMSGH_CHANNEL=2
# Optional separate DLT template for customer delivery codes (same placeholder rule). When unset, delivery
# codes are never sent on the sign-in template; customers read them on their order screen instead.
SMSGH_DELIVERY_TEMPLATE_ID=
SMSGH_DELIVERY_TEMPLATE_TEXT=
SMSGH_ROUTE=

# "Use my current location" (address form and PIN check) turns coordinates into an address on the
# server, so the customer's location never goes to a third party from their browser. Defaults to the
# public OpenStreetMap Nominatim service, whose policy allows only light use (1 request/second) and
# requires a contact: set GEOCODER_CONTACT to the store's email. For busy stores use a commercial
# Nominatim-compatible provider. Leave GEOCODER_URL empty to switch the feature off.
# GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_CONTACT=

# Comma-separated Google OAuth client IDs (web and Android) accepted for "Continue with Google".
GOOGLE_CLIENT_IDS=

# Ordering remains disabled in the example environment until a staging acceptance run is approved.
CHECKOUT_ENABLED=false
# Online payments stay off until Razorpay test-mode acceptance is complete.
ONLINE_PAYMENTS_ENABLED=false
# Use test keys only until a separately approved live release.
RAZORPAY_MODE=test
# Live payments additionally require NODE_ENV=production, DEPLOYMENT_ENV=production and this flag.
# The API and worker refuse to start if live mode or an rzp_live_ key is configured without all three.
RAZORPAY_LIVE_APPROVED=false
# Razorpay server-side credentials. Never expose RAZORPAY_KEY_SECRET or webhook secret to clients.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
# Gateway refunds are disabled until partial/full refund acceptance tests pass.
RAZORPAY_REFUNDS_ENABLED=false

# Local automation only (load tests, E2E). Refused in production.
# DEV_DISABLE_RATE_LIMIT=true

# Background worker (apps/worker reads this same file).
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
# Storefront cache refresh after admin changes. Same token as the storefront's REVALIDATE_TOKEN.
# STOREFRONT_REVALIDATE_URL=http://localhost:3000/internal/revalidate
# REVALIDATE_TOKEN=
